# Copy to infra/desk.env (gitignored). Defaults for create-droplet.sh and droplet.sh up/down.
NC_DOMAIN=nc.example.com   # hostname with DNS on DigitalOcean; empty = plain http on the IP
NC_HOST_NAME=nc            # name clients see
NC_DESK=nc                 # desk volume is desk-$NC_DESK
NC_DESK_GB=1               # desk volume size, created once
NC_DESK_USER=user          # desktop account whose locker lives on the desk
NC_KEYBOARD=us               # desktop keyboard layout (us, us:dvorak, gb, ...); clients also set it
NC_REGION=nyc3             # the desk volume only attaches in its own region
NC_SIZE=s-2vcpu-4gb        # default computer size for "up"
