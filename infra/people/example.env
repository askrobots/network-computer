# A person's desk. Copy with: infra/people.sh new NAME   (profiles are gitignored:
# they can hold the person's own API keys). Edit, then: infra/people.sh up NAME
#
# who
NC_HOST_NAME=alice               # the machine's name (clients see it)
NC_DESK=alice                    # the desk volume is desk-$NC_DESK (created once, kept)
NC_DESK_USER=alice               # their login on the desktop (lowercase)
NC_WELCOME_NAME="Alice"          # how the welcome note greets them
NC_DOMAIN=alice.example.com      # their address (DNS on DigitalOcean); empty = plain http
NC_TZ=America/Chicago            # their time zone (the device they connect from also sets it)
NC_KEYBOARD=us                   # us, us:dvorak, gb, de...
#
# the machine
NC_REGION=nyc3                   # the desk volume only attaches in its own region
NC_SIZE=s-2vcpu-4gb              # s-4vcpu-8gb for voice and heavier apps
NC_DESK_GB=1                     # desk volume size (grows later, never shrinks)
#
# their things (applied on the first provision; never over their own changes)
NC_EXTRA_PACKAGES=""             # more apps from Ubuntu, e.g. "gimp inkscape libreoffice"
NC_VOICE_STYLE=""                # e.g. "Brief and friendly. Call me Alice."
NC_ANTHROPIC_API_KEY=""          # their own keys, for voice and AI (optional)
NC_OPENAI_API_KEY=""
#
# keeping it running
NC_KEEP_RUNNING=yes              # yes: health checks restart anything stopped; no auto-stop
