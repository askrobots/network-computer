#!/usr/bin/env python3
"""nc-webapp: a web page as a desktop app, in its own window.

  nc-webapp NAME URL [ICON]

No tabs, no address bar: a window with the app's name, its own taskbar entry
and icon, and its own cookie store (so "Talk" stays signed in as itself).
Links to other sites open in the normal browser. The microphone and camera
are allowed for local pages only (the object server on this desk).
Keys: Ctrl+R reload, Ctrl+[ / Alt+Left back, Ctrl+W or Ctrl+Q close.

Built on WebKitGTK (the engine of GNOME Web). The object server's pages use it
through the desk's sign-in helper: nc-webapp Talk http://localhost:8009/open?next=/talk
"""
import os
import re
import subprocess
import sys
from urllib.parse import urlsplit

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import GLib, Gtk, WebKit2  # noqa: E402

LOCAL = {"localhost", "127.0.0.1"}


def main():
    if len(sys.argv) < 3:
        print(__doc__)
        sys.exit(2)
    name, url = sys.argv[1], sys.argv[2]
    icon = sys.argv[3] if len(sys.argv) > 3 else "applications-internet"
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "app"
    GLib.set_prgname(f"nc-{slug}")        # its own taskbar group
    GLib.set_application_name(name)

    data = os.path.join(GLib.get_user_data_dir(), "nc-webapp", slug)
    cache = os.path.join(GLib.get_user_cache_dir(), "nc-webapp", slug)
    manager = WebKit2.WebsiteDataManager(base_data_directory=data, base_cache_directory=cache)
    ctx = WebKit2.WebContext.new_with_website_data_manager(manager)
    manager.get_cookie_manager().set_persistent_storage(os.path.join(data, "cookies.sqlite"),
                                                        WebKit2.CookiePersistentStorage.SQLITE)
    view = WebKit2.WebView.new_with_context(ctx)
    s = view.get_settings()
    s.set_enable_media_stream(True)
    s.set_enable_developer_extras(True)

    win = Gtk.Window(title=name)
    win.set_icon_name(icon)
    win.set_default_size(1100, 800)
    win.add(view)
    win.connect("destroy", Gtk.main_quit)
    view.connect("notify::title", lambda v, _: win.set_title(
        f"{v.get_title()} — {name}" if v.get_title() and v.get_title() != name else name))

    def outside(uri):
        host = urlsplit(uri).hostname or ""
        return uri.startswith(("http://", "https://")) and host not in LOCAL

    def browser(uri):
        subprocess.Popen(["xdg-open", uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def decide(v, decision, kind):
        if kind in (WebKit2.PolicyDecisionType.NAVIGATION_ACTION, WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION):
            uri = decision.get_navigation_action().get_request().get_uri()
            if outside(uri) or kind == WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION:
                browser(uri)          # other sites, and new windows, go to the real browser
                decision.ignore()
                return True
        return False

    def permission(v, request):
        local = (urlsplit(v.get_uri() or "").hostname or "") in LOCAL
        if isinstance(request, WebKit2.UserMediaPermissionRequest) and local:
            request.allow()
        else:
            request.deny()
        return True

    def keys(w, ev):
        ctrl = ev.state & 4               # Gdk.ModifierType.CONTROL_MASK
        alt = ev.state & 8                # Gdk.ModifierType.MOD1_MASK
        k = ev.keyval
        if ctrl and k in (ord("r"), ord("R")):
            view.reload()
        elif (ctrl and k == ord("[")) or (alt and k == 0xff51):   # Left
            view.go_back()
        elif ctrl and k in (ord("w"), ord("W"), ord("q"), ord("Q")):
            win.destroy()
        else:
            return False
        return True

    view.connect("decide-policy", decide)
    view.connect("permission-request", permission)
    win.connect("key-press-event", keys)
    view.load_uri(url)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
