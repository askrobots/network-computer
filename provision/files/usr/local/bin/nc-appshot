#!/bin/sh
# nc-appshot OUT.jpg: the screen below the panel and the window title bar (a
# maximized app), 1280 wide, for docs and sites (the release screenshots)
set -e
set -- "$1" $(xdotool getdisplaygeometry)
exec ffmpeg -hide_banner -loglevel error -y -f x11grab -draw_mouse 0 -video_size "$2x$(($3 - 50))" \
  -i "${DISPLAY:-:0}+0,50" -frames:v 1 -vf scale=1280:-2 -q:v 3 "$1"
