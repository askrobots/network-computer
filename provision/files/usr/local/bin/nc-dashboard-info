#!/bin/sh
# Lines for the desktop dashboard (conky runs this every minute): who and where
# this computer is, what it costs, and whether its services are up. Reads only
# /etc/nc/info (no secrets); API keys are listed by name, never value.
# "$$" is conky for "$". DigitalOcean bills at most 672 hours a month.
#
#   nc-dashboard-info [full|compact|mini]
# full: everything (a big screen); compact and mini (smaller screens, a phone):
# the most important first, in fewer lines: services only as "ok" or by what is
# failing, cost as what was spent. See docs/DESIGN.md, "less room, less shown".
MODE=${1:-full}
[ -r /etc/nc/info ] && . /etc/nc/info
UP=$(awk '{print $1}' /proc/uptime)
failing() {
  for s in host rendezvous voice object-server audio; do
    systemctl is-active --quiet nc-$s 2>/dev/null || printf '%s ' "$s"
  done
}
use_line() {
  S=$(cat /run/nc-host/idle 2>/dev/null)
  case "$S" in
    busy*)       echo "${S#busy } connected" ;;
    idle-since*) echo "idle $(( ($(date +%s) - ${S#idle-since }) / 60 )) min" ;;
  esac
}
if [ "$MODE" != full ]; then
  F=$(failing)
  if [ -n "$F" ]; then svc="\${color4}down: ${F% }\${color}"; else svc="\${color3}services ok\${color}"; fi
  spent=""
  [ -n "$NC_PRICE_HOURLY" ] && spent=$(awk -v p="$NC_PRICE_HOURLY" -v u="$UP" 'BEGIN{printf "$$%.2f spent", p*u/3600}')
  if [ "$MODE" = mini ]; then
    echo "\${color2}${NC_HOST_NAME:-$(hostname)}\${color}  $svc"
    echo "$(use_line)${spent:+  $spent}"
  else
    echo "\${color2}${NC_HOST_NAME:-$(hostname)}\${color}  ${NC_DOMAIN:-${NC_PUBLIC_IP:-}}"
    echo "$svc   $(use_line)"
    [ -n "$NC_PRICE_HOURLY" ] && awk -v p="$NC_PRICE_HOURLY" -v u="$UP" 'BEGIN{printf "$$%.3f/h   $$%.2f since boot\n", p, p*u/3600}'
  fi
  exit 0
fi
PRIV=$(curl -s -m 1 http://169.254.169.254/metadata/v1/interfaces/private/0/ipv4/address 2>/dev/null)
[ -n "$PRIV" ] || PRIV=$(ip -4 -o addr show 2>/dev/null | awk '$2!="lo" && $4 ~ /^10\.|^172\.(1[6-9]|2[0-9]|3[01])\.|^192\.168\./ {sub("/.*","",$4); print $4; exit}')
REGION=$(curl -s -m 1 http://169.254.169.254/metadata/v1/region 2>/dev/null)
echo "\${color2}THIS COMPUTER\${color}"
echo "name     ${NC_HOST_NAME:-$(hostname)}${NC_DOMAIN:+  ($NC_DOMAIN)}"
echo "public   ${NC_PUBLIC_IP:-?}"
echo "private  ${PRIV:-none}"
echo "where    ${REGION:-?}  ${NC_SIZE}"
if [ -n "$NC_PRICE_HOURLY" ]; then
  awk -v p="$NC_PRICE_HOURLY" -v u="$UP" 'BEGIN{
    printf "cost     $$%.3f/h   $$%.2f/day   $$%.0f/month max\n", p, p*24, p*672
    printf "spent    $$%.2f since this boot (%.1f h)\n", p*u/3600, u/3600 }'
fi
S=$(cat /run/nc-host/idle 2>/dev/null); A=$(cat /etc/nc/autostop 2>/dev/null)
case "$S" in
  busy*)       echo "use      ${S#busy } device(s) connected" ;;
  idle-since*) M=$(( ($(date +%s) - ${S#idle-since }) / 60 ))
               echo "use      idle ${M} min${A:+   (auto-stop at ${A} min)}" ;;
esac
echo
echo "\${color2}SERVICES\${color}"
for s in host rendezvous voice object-server audio; do
  st=$(systemctl is-active nc-$s 2>/dev/null)
  if [ "$st" = active ]; then c='${color3}'; else c='${color4}'; fi
  printf "%-14s %s%s\${color}\n" "$s" "$c" "$st"
done
K=$(grep -o '^[A-Z_]*_KEY=.' "$HOME/.config/dbbasic/ai.env" 2>/dev/null | cut -d= -f1 | sed 's/_API_KEY$//;s/_KEY$//' | tr 'A-Z\n' 'a-z ')
echo "keys           ${K:-none}"
