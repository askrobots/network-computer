#!/bin/sh
# Make the desk's object server ready for voice: the desk user exists, their
# AI keys (from the desk's secrets file) are stored as the user's service keys,
# and the app packages are installed. Run by apply.sh as root; safe to repeat.
# Key values are read from the file and passed on stdin, never printed.
set -e
. /etc/nc/env
. /etc/nc/object-server.env
OS=/opt/dbbasic-object-server; PY=$OS/.venv/bin/python
U=$NC_DESK_USER
asuser() { runuser -u "$U" -- env DBBASIC_DATA_DIR="$DBBASIC_DATA_DIR" DBBASIC_OBJECTS_DIR="$DBBASIC_OBJECTS_DIR" "$@"; }
cd "$OS"
for i in $(seq 30); do curl -sf http://127.0.0.1:8001/health >/dev/null && break; sleep 1; done

if ! asuser "$PY" object_identity_cli.py list-users --json 2>/dev/null | grep -q "\"$U\""; then
  head -c 24 /dev/urandom | base64 | asuser "$PY" object_identity_cli.py create-superuser --user-id "$U" --display-name "$U" --password-stdin >/dev/null
  echo "   object server user $U created"
fi

SECRETS="$(getent passwd "$U" | cut -d: -f6)/.config/dbbasic/ai.env"   # the dbbasic apps' key file
if [ -r "$SECRETS" ]; then
  asuser "$PY" - "$U" "$SECRETS" <<'PYEOF'
import sys, object_service_keys, os
user, path = sys.argv[1], sys.argv[2]
names = {"ANTHROPIC_API_KEY": "anthropic", "OPENAI_API_KEY": "openai"}
done = []
for line in open(path):
    k, _, v = line.strip().partition("=")
    if k in names and v.strip():
        object_service_keys.set_service_key(user, names[k], v.strip().strip('"\''),
                                            base_dir=os.environ["DBBASIC_DATA_DIR"])
        done.append(names[k])
print("   keys stored for:", ", ".join(done) or "none")
PYEOF
fi

for p in app-theme app-views app-nav app-shell app-files app-projects app-collab app-notes app-tasks app-notify app-settings app-sites; do
  code=$(curl -s -o /dev/null -w '%{http_code}' -X POST -H "Authorization: Token $DBBASIC_ADMIN_TOKEN" "http://127.0.0.1:8001/packages/$p/install")
  echo "   package $p: $code"
done

# the key ~/Objects signs in with (nc-object-files): minted once and kept
# root-only, on the desk volume when there is one so a new computer reuses it;
# minted again only when it stops working (revoked, or a fresh data dir).
# Passed to curl on stdin, never on a command line or printed.
DAVSEC=/etc/nc/davfs2.secrets; DAVURL=http://127.0.0.1:8001/dav/files/
if [ -d /desk/nc ]; then
  [ -e /desk/nc/davfs2.secrets ] || { [ -f $DAVSEC ] && [ ! -L $DAVSEC ] && mv $DAVSEC /desk/nc/davfs2.secrets; } || true
  ln -sfn /desk/nc/davfs2.secrets $DAVSEC
fi
davok() {
  [ -s $DAVSEC ] || return 1
  code=$(awk -v u="$U" '{printf "user = \"%s:%s\"\n", u, $3}' $DAVSEC |
         curl -s -o /dev/null -w '%{http_code}' -K - -X PROPFIND -H 'Depth: 0' $DAVURL)
  [ "$code" = 207 ]
}
if ! davok; then
  KEY=$(curl -s -X POST -H "Authorization: Token $DBBASIC_ADMIN_TOKEN" -H 'Content-Type: application/json' \
          -d '{"name":"desk folder (~/Objects)"}' "http://127.0.0.1:8001/identity/users/$U/api-keys" |
        "$PY" -c 'import json,sys; print(json.load(sys.stdin).get("token",""))')
  if [ -n "$KEY" ]; then
    (umask 077; printf '%s %s %s\n' "$DAVURL" "$U" "$KEY" > "$(readlink -f $DAVSEC)")
    davok && echo "   ~/Objects key minted" || echo "   !! ~/Objects key minted but refused (is DBBASIC_ENABLE_WEBDAV on?)"
  else
    echo "   !! could not mint the ~/Objects key"
  fi
  unset KEY
fi

# the object server for the desk user's dbbasic apps (Webmaster publishes
# there): ~/.config/dbbasic/object-server.env, 0600, the user's; its own API key,
# apart from ~/Objects' root-only one, minted again only if it stops working
UH=$(getent passwd "$U" | cut -d: -f6); OSF="$UH/.config/dbbasic/object-server.env"
oskey=$(sed -n 's/^DBBASIC_OBJECT_SERVER_KEY=//p' "$OSF" 2>/dev/null || true)
code=none   # (not "$( [ -n ] && ...)": under set -e an empty key would end the script)
if [ -n "$oskey" ]; then
  code=$(printf 'header = "Authorization: Bearer %s"\n' "$oskey" |
         curl -s -o /dev/null -w '%{http_code}' -K - -X PROPFIND -H 'Depth: 0' $DAVURL)
fi
if [ "$code" != 207 ]; then
  KEY=$(curl -s -X POST -H "Authorization: Token $DBBASIC_ADMIN_TOKEN" -H 'Content-Type: application/json' \
          -d '{"name":"desk apps (~/.config/dbbasic/object-server.env)"}' "http://127.0.0.1:8001/identity/users/$U/api-keys" |
        "$PY" -c 'import json,sys; print(json.load(sys.stdin).get("token",""))')
  if [ -n "$KEY" ]; then
    runuser -u "$U" -- mkdir -p "$UH/.config/dbbasic"
    (umask 077; printf '%s\n' "# the object server the dbbasic apps use (Webmaster publishes here)" \
      "DBBASIC_OBJECT_SERVER_URL=http://127.0.0.1:8001" "DBBASIC_OBJECT_SERVER_USER=$U" \
      "DBBASIC_OBJECT_SERVER_KEY=$KEY" > "$OSF")
    chown "$U:$U" "$OSF"; chmod 600 "$OSF"
    echo "   ~/.config/dbbasic/object-server.env written"
  fi
  unset KEY
fi

# the voice style from the profile, only if the user hasn't set one
if [ -s /etc/nc/voice-style.initial ]; then
  T=$(curl -s -X POST -H "Authorization: Token $DBBASIC_ADMIN_TOKEN" -H "Content-Type: application/json" \
        -d "{\"user_id\":\"$U\",\"ttl_seconds\":300,\"label\":\"bootstrap\"}" http://127.0.0.1:8001/identity/sessions |
      "$PY" -c 'import json,sys; print(json.load(sys.stdin).get("token",""))')
  cur=$(curl -s -H "Authorization: Bearer $T" http://127.0.0.1:8001/prefs/voice_style | "$PY" -c 'import json,sys; print(json.load(sys.stdin).get("value",""))' 2>/dev/null)
  if [ -z "$cur" ]; then
    "$PY" -c 'import json,sys; print(json.dumps({"value": open("/etc/nc/voice-style.initial").read()}))' |
      curl -s -o /dev/null -X PUT -H "Authorization: Bearer $T" -H "Content-Type: application/json" --data-binary @- \
        http://127.0.0.1:8001/prefs/voice_style && echo "   voice style set"
  fi
  rm -f /etc/nc/voice-style.initial
fi
