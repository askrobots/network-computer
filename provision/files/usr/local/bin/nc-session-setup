#!/bin/sh
# Per-session desktop settings, applied at every login (autostart) and by
# provisioning. Safe to run again.
[ "$(id -un)" = root ] && exec nc-as-user "$0" "$@"
q() { xfconf-query -c xfce4-keyboard-shortcuts "$@"; }
# Alt+Space: the search and launch bar; the window menu moves to Shift+Alt+Space
q -p '/xfwm4/custom/<Alt>space' -r 2>/dev/null
q -p '/xfwm4/custom/<Shift><Alt>space' -n -t string -s popup_menu_key 2>/dev/null || q -p '/xfwm4/custom/<Shift><Alt>space' -s popup_menu_key
q -p '/commands/custom/<Alt>space' -n -t string -s nc-launch 2>/dev/null || q -p '/commands/custom/<Alt>space' -s nc-launch
echo "shortcuts: Alt+Space search and launch; Shift+Alt+Space window menu"

# an Object Server icon on the desktop, once (the user may delete it), marked
# trusted so Xfce opens it without the "untrusted launcher" question
D=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop"); L="$D/Object Server.desktop"
if [ -e "$L" ] && ! grep -q '^Exec=nc-object-open' "$L"; then rm -f "$L" "$HOME/.config/nc/object-icon-placed"; fi   # an older version
if [ ! -e "$L" ] && [ ! -e "$HOME/.config/nc/object-icon-placed" ]; then
  cp /usr/share/applications/nc-object-home.desktop "$L" && chmod +x "$L" &&
    gio set -t string "$L" metadata::xfce-exe-checksum "$(sha256sum "$L" | cut -d' ' -f1)" 2>/dev/null
  mkdir -p "$HOME/.config/nc" && touch "$HOME/.config/nc/object-icon-placed"
fi

# the dbbasic apps (nc-apps), Today and Radio on the desktop, so they are one double-click or
# double-tap away: each placed once and marked trusted (no "untrusted
# launcher" question); one you delete stays deleted; one installed later
# appears (nc-apps install runs this)
for f in /usr/share/applications/dbbasic-*.desktop /usr/share/applications/nc-today.desktop /usr/share/applications/nc-radio.desktop; do
  [ -f "$f" ] || continue
  # Today and Radio only while they are on (~/.config/nc/dashboard.env)
  case $f in
    */nc-today.desktop) grep -Eqi '^(WEATHER|NEWS)=(on|"on")?$' "$HOME/.config/nc/dashboard.env" 2>/dev/null ||
                          [ ! -e "$HOME/.config/nc/dashboard.env" ] || continue ;;
    */nc-radio.desktop) grep -Eqi '^RADIO=(off|no|false|0|"off")' "$HOME/.config/nc/dashboard.env" 2>/dev/null && continue ;;
  esac
  n=$(basename "$f" .desktop); mark="$HOME/.config/nc/placed-$n"
  # a copy placed before the apps had launchers: bring its command up to date
  if [ -e "$D/$n.desktop" ] && grep -q '^Exec=/desk/apps/' "$D/$n.desktop"; then
    sed -i "s|^Exec=.*|$(grep '^Exec=' "$f")|" "$D/$n.desktop"
    gio set -t string "$D/$n.desktop" metadata::xfce-exe-checksum "$(sha256sum "$D/$n.desktop" | cut -d' ' -f1)" 2>/dev/null
  fi
  [ -e "$mark" ] && continue
  cp "$f" "$D/$n.desktop" && chmod +x "$D/$n.desktop" &&
    gio set -t string "$D/$n.desktop" metadata::xfce-exe-checksum "$(sha256sum "$D/$n.desktop" | cut -d' ' -f1)" 2>/dev/null
  mkdir -p "$HOME/.config/nc" && touch "$mark"
done

# ~/Objects (the object server's files, nc-object-files): in the file manager's
# side pane always, and on the desktop once, as a link the user may delete
O="$HOME/Objects"; B="$HOME/.config/gtk-3.0/bookmarks"
mkdir -p "$(dirname "$B")"
grep -qs "^file://$O " "$B" || echo "file://$O Objects" >> "$B"
if [ ! -e "$D/Objects" ] && [ ! -e "$HOME/.config/nc/objects-link-placed" ]; then
  ln -s "$O" "$D/Objects" && mkdir -p "$HOME/.config/nc" && touch "$HOME/.config/nc/objects-link-placed"
fi

# notifications bottom right: top right is where browser tabs and window buttons are
xfconf-query -c xfce4-notifyd -p /notify-location -n -t int -s 3 2>/dev/null || xfconf-query -c xfce4-notifyd -p /notify-location -s 3

# a plain background, once: it streams far cheaper than a detailed picture, and the
# dashboard sits on it (the user can pick any wallpaper afterwards)
if [ ! -e "$HOME/.config/nc/plain-background" ]; then
  props=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/workspace[0-9]*/image-style$')
  if [ -z "$props" ]; then   # a brand-new desktop has written none yet: name them from the screen
    for mon in $(xrandr --listmonitors 2>/dev/null | awk 'NR>1{print $NF}'); do
      for ws in 0 1 2 3; do props="$props /backdrop/screen0/monitor$mon/workspace$ws/image-style"; done
    done
  fi
  set_ok=""
  for p in $props; do
    b=${p%image-style}
    xfconf-query -c xfce4-desktop -p "${b}image-style" -n -t int -s 0 2>/dev/null ||
      xfconf-query -c xfce4-desktop -p "${b}image-style" -s 0 || continue           # no image
    xfconf-query -c xfce4-desktop -p "${b}color-style" -n -t int -s 0 2>/dev/null ||
      xfconf-query -c xfce4-desktop -p "${b}color-style" -s 0                        # solid color
    xfconf-query -c xfce4-desktop -p "${b}rgba1" -n -t double -s 0.075 -t double -s 0.09 \
      -t double -s 0.125 -t double -s 1 2>/dev/null ||
    xfconf-query -c xfce4-desktop -p "${b}rgba1" -t double -s 0.075 -t double -s 0.09 \
      -t double -s 0.125 -t double -s 1
    set_ok=1
  done
  # done only once it worked: a first login may come before the desktop is ready
  [ -z "$set_ok" ] || { mkdir -p "$HOME/.config/nc" && touch "$HOME/.config/nc/plain-background"; }
fi
pgrep -u "$(id -u)" -x conky >/dev/null || (setsid nc-dashboard >/dev/null 2>&1 &)
