#!/bin/sh
# Per-session desktop settings, applied at every login (autostart) and by
# provisioning. Safe to run again.
[ "$(id -un)" = root ] && exec nc-as-user "$0" "$@"
q() { xfconf-query -c xfce4-keyboard-shortcuts "$@"; }
# Alt+Space: the search and launch bar; the window menu moves to Shift+Alt+Space
q -p '/xfwm4/custom/<Alt>space' -r 2>/dev/null
q -p '/xfwm4/custom/<Shift><Alt>space' -n -t string -s popup_menu_key 2>/dev/null || q -p '/xfwm4/custom/<Shift><Alt>space' -s popup_menu_key
q -p '/commands/custom/<Alt>space' -n -t string -s nc-launch 2>/dev/null || q -p '/commands/custom/<Alt>space' -s nc-launch
echo "shortcuts: Alt+Space search and launch; Shift+Alt+Space window menu"

# an Object Server icon on the desktop, once (the user may delete it), marked
# trusted so Xfce opens it without the "untrusted launcher" question
D=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop"); L="$D/Object Server.desktop"
if [ -e "$L" ] && ! grep -q '^Exec=nc-object-open' "$L"; then rm -f "$L" "$HOME/.config/nc/object-icon-placed"; fi   # an older version
if [ ! -e "$L" ] && [ ! -e "$HOME/.config/nc/object-icon-placed" ]; then
  cp /usr/share/applications/nc-object-home.desktop "$L" && chmod +x "$L" &&
    gio set -t string "$L" metadata::xfce-exe-checksum "$(sha256sum "$L" | cut -d' ' -f1)" 2>/dev/null
  mkdir -p "$HOME/.config/nc" && touch "$HOME/.config/nc/object-icon-placed"
fi

# notifications bottom right: top right is where browser tabs and window buttons are
xfconf-query -c xfce4-notifyd -p /notify-location -n -t int -s 3 2>/dev/null || xfconf-query -c xfce4-notifyd -p /notify-location -s 3

# a plain background, once: it streams far cheaper than a detailed picture, and the
# dashboard sits on it (the user can pick any wallpaper afterwards)
if [ ! -e "$HOME/.config/nc/plain-background" ]; then
  for p in $(xfconf-query -c xfce4-desktop -l | grep '/workspace[0-9]*/image-style$'); do
    xfconf-query -c xfce4-desktop -p "$p" -s 0                                  # no image
    xfconf-query -c xfce4-desktop -p "${p%image-style}color-style" -s 0 2>/dev/null   # solid color
    xfconf-query -c xfce4-desktop -p "${p%image-style}rgba1" -n -t double -s 0.075 -t double -s 0.09 \
      -t double -s 0.125 -t double -s 1 2>/dev/null ||
    xfconf-query -c xfce4-desktop -p "${p%image-style}rgba1" -t double -s 0.075 -t double -s 0.09 \
      -t double -s 0.125 -t double -s 1
  done
  mkdir -p "$HOME/.config/nc" && touch "$HOME/.config/nc/plain-background"
fi
pgrep -u "$(id -u)" -x conky >/dev/null || (setsid nc-dashboard >/dev/null 2>&1 &)
