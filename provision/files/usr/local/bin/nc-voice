#!/usr/bin/env python3
"""nc-voice: talk to the desk.

The client's 🎙️ button turns listening on and off (through nc-host's local
socket). While on, the client's microphone (the pulse source nc-mic-in) is cut
into utterances at pauses, and each goes to the local object server: speech to
text, then the AI, then text to speech, played on the desk so it comes back
through the stream. The AI answers with what to say and which desktop actions
to take; nc-voice does them in the desktop session and reports every step
(state, heard, said, did, error) to the client's transcript panel.

Standard library only. Configuration from the environment:
  DBBASIC_ADMIN_TOKEN   the object server's admin token (to open a session)
  NC_DESK_USER          the object server user to act as (default: this user)
  NC_OBJECT_SERVER      default http://127.0.0.1:8001
  NC_VOICE_MODEL        default anthropic:claude-sonnet-5 (Haiku is ~0.6 s quicker but
                        read screenshots right 2 times in 5; Sonnet 4 in 4)
  NC_VOICE_TTS          piper (default when installed: local, starts speaking in
                        about half a second), openai, or local (espeak)
  NC_PIPER_VOICE        default /opt/piper/voices/en_US-lessac-medium.onnx
  NC_VOICE_SOURCE       pulse source to listen to, default nc-mic-in
  NC_HOST_SOCKET        default /run/nc-host/send.sock
"""
import array
import glob
import http.client
import io
import json
import math
import os
import queue
import re
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import wave

OBJ = os.environ.get("NC_OBJECT_SERVER", "http://127.0.0.1:8001").rstrip("/")
ADMIN = os.environ.get("DBBASIC_ADMIN_TOKEN", "")
USER = os.environ.get("NC_DESK_USER") or os.environ.get("USER", "")
MODEL = os.environ.get("NC_VOICE_MODEL", "anthropic:claude-sonnet-5")
try:   # Piper: fast local speech; present when nc-voice runs on /opt/piper's python
    from piper import PiperVoice
except ImportError:
    PiperVoice = None
TTS = os.environ.get("NC_VOICE_TTS", "piper" if PiperVoice else "openai")
PIPER_VOICE = os.environ.get("NC_PIPER_VOICE", "/opt/piper/voices/en_US-lessac-medium.onnx")
SOURCE = os.environ.get("NC_VOICE_SOURCE", "nc-mic-in")
SOCK = os.environ.get("NC_HOST_SOCKET", "/run/nc-host/send.sock")

RATE = 16000
FRAME = 320            # 20 ms of 16-bit mono
PREROLL = 15           # frames kept from before speech starts (300 ms)
START = 3              # loud frames that start an utterance
END = 35               # quiet frames that end one (700 ms)
MAX_FRAMES = 30 * 50   # 30 s
MIN_SPEECH = 20        # 400 ms of speech, or it was a noise
ONCE_WAIT = 8          # seconds to wait for the one phrase before giving up


def log(*a):
    print(*a, file=sys.stderr, flush=True)


# ---------- nc-host: commands in, events out ----------

class UnixHTTP(http.client.HTTPConnection):
    def __init__(self, path, timeout=None):
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(self.unix_path)
        self.sock = s


def event(kind, text=""):
    log(f"{kind}: {text}")
    try:
        c = UnixHTTP(SOCK, timeout=5)
        c.request("POST", "/voice/event", json.dumps({"kind": kind, "text": text}),
                  {"Content-Type": "application/json"})
        c.getresponse().read()
        c.close()
    except OSError:
        pass


# ---------- the object server: speech to text, AI, text to speech ----------

class ObjectServer:
    def __init__(self):
        self.token = None

    def _open_session(self):
        body = json.dumps({"user_id": USER, "ttl_seconds": 12 * 3600, "label": "nc-voice"}).encode()
        req = urllib.request.Request(OBJ + "/identity/sessions", body, method="POST",
                                     headers={"Authorization": "Token " + ADMIN,
                                              "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=15) as r:
            res = json.load(r)
        self.token = res.get("token") or (res.get("session") or {}).get("token")
        if not self.token:
            raise RuntimeError("object server returned no session token")

    def call(self, path, body, ctype, timeout=60, retry=True):
        if not self.token:
            self._open_session()
        req = urllib.request.Request(OBJ + path, body, method="POST",
                                     headers={"Authorization": "Bearer " + self.token,
                                              "Content-Type": ctype})
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.read(), r.headers.get("Content-Type", "")
        except urllib.error.HTTPError as e:
            if e.code == 401 and retry:
                self.token = None
                return self.call(path, body, ctype, timeout, retry=False)
            detail = e.read().decode(errors="replace")
            try:
                detail = json.loads(detail).get("error", detail)
            except ValueError:
                pass
            raise RuntimeError(f"{path}: {detail}") from None

    def stt(self, wav):
        data, _ = self.call("/api/stt", wav, "audio/wav")
        return json.loads(data).get("text", "").strip()

    def chat(self, message, history, system, attachments=None):
        req = {"message": message, "model": MODEL, "system": system, "history": history}
        if attachments:
            req["attachments"] = attachments
        body = json.dumps(req).encode()
        data, _ = self.call("/api/ai/chat", body, "application/json", timeout=90)
        return json.loads(data).get("reply", "")

    def upload(self, name, data, ctype):
        """Store a file as the user's; returns its id (chat attachments are file ids)."""
        b = "ncvoice" + os.urandom(8).hex()
        body = (f"--{b}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"{name}\"\r\n"
                f"Content-Type: {ctype}\r\n\r\n").encode() + data + f"\r\n--{b}--\r\n".encode()
        res, _ = self.call("/api/files", body, f"multipart/form-data; boundary={b}")
        return json.loads(res)["file"]["id"]

    def delete_file(self, file_id):
        try:
            req = urllib.request.Request(f"{OBJ}/api/files/{file_id}", method="DELETE",
                                         headers={"Authorization": "Bearer " + self.token})
            urllib.request.urlopen(req, timeout=10).read()
        except (OSError, urllib.error.HTTPError):
            pass

    def tts(self, text):
        body = json.dumps({"text": text[:800], "engine": TTS}).encode()
        data, _ = self.call("/api/tts", body, "application/json")
        return data


# ---------- the desktop ----------

def desk(*cmd, timeout=10):
    """Run a command in the desk user's desktop session."""
    return subprocess.run(["nc-as-user", *cmd], capture_output=True, text=True, timeout=timeout)


def screenshot():
    """The desk's screen as a JPEG, at most 1280 wide: enough to read, cheap to send."""
    r = subprocess.run(["nc-as-user", "ffmpeg", "-loglevel", "error", "-f", "x11grab", "-i", ":0",
                        "-frames:v", "1", "-vf", "scale='min(1280,iw)':-2", "-q:v", "4",
                        "-f", "image2", "-c:v", "mjpeg", "pipe:1"], capture_output=True, timeout=15)
    if r.returncode != 0 or not r.stdout:
        raise RuntimeError("could not take a screenshot")
    return r.stdout


def open_windows():
    try:
        out = desk("wmctrl", "-l").stdout
    except (OSError, subprocess.SubprocessError):
        return []
    titles = []
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4 and parts[3] not in ("Desktop", "xfce4-panel"):
            titles.append(parts[3])
    return titles


def installed_apps():
    apps = {}
    for path in sorted(glob.glob("/usr/share/applications/*.desktop")):
        name, hidden = None, False
        with open(path, errors="replace") as f:
            for line in f:
                if line.startswith("[") and name is not None and not line.startswith("[Desktop Entry]"):
                    break
                if line.startswith("Name=") and name is None:
                    name = line[5:].strip()
                elif line.strip() in ("NoDisplay=true", "Hidden=true"):
                    hidden = True
        if name and not hidden:
            apps[os.path.basename(path)[:-8]] = name
    return apps


APPS = installed_apps()


def find_app(name):
    if name in APPS:
        return name
    n = name.lower()
    match = [k for k, v in APPS.items() if n in (k + " " + v).lower()]
    return match[0] if match else None


def raise_app(app):
    """Bring an app's window forward if it has one; True if it did."""
    for key in {app.split(".")[-1].lower(), APPS.get(app, "").lower()}:
        if key and (desk("wmctrl", "-x", "-a", key).returncode == 0 or desk("wmctrl", "-a", key).returncode == 0):
            return True
    return False


def launch(app):
    subprocess.Popen(["nc-as-user", "gtk-launch", app], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def act(a):
    """Do one action from the AI; return what was done, for the transcript.
    Opening and switching check the desktop as it is now, whatever the AI
    believes: the user opens and closes things too."""
    kind = a.get("do")
    if kind == "open_app":
        name = a.get("app", "")
        app = find_app(name)
        if not app:
            raise RuntimeError(f"no app called {name}")
        if raise_app(app):
            return f"switched to {APPS[app]} (already open)"
        launch(app)
        return f"opened {APPS[app]}"
    if kind == "switch":
        w = a.get("window", "")
        if desk("wmctrl", "-a", w).returncode == 0:
            return f"switched to {w}"
        app = find_app(w)
        if app:   # not open (any more): start it
            launch(app)
            return f"{APPS[app]} was not open: opened it"
        raise RuntimeError(f"no window like {w}")
    if kind == "close":
        w = a.get("window", "")
        if desk("wmctrl", "-c", w).returncode != 0:
            raise RuntimeError(f"no window like {w}")
        return f"closed {w}"
    if kind == "open":
        t = os.path.expanduser(a.get("target", ""))
        subprocess.Popen(["nc-as-user", "xdg-open", t], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return f"opened {a.get('target', '')}"
    if kind == "type":
        text = a.get("text", "")
        desk("xdotool", "type", "--delay", "8", "--", text, timeout=60)
        return f"typed {len(text)} characters"
    if kind == "keys":
        k = a.get("keys", "")
        if not re.fullmatch(r"[A-Za-z0-9_+ ]{1,60}", k):
            raise RuntimeError(f"odd keys {k!r}")
        desk("xdotool", "key", "--", *k.split())
        return f"pressed {k}"
    if kind == "search":
        q = a.get("query", "")
        subprocess.Popen(["nc-launch", "search", q], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return f"searched for {q}"
    raise RuntimeError(f"unknown action {kind!r}")


SYSTEM = """You are the voice of a Linux desktop (Xfce) that its user reaches through a
remote-desktop client. You hear them through their microphone and they hear your
"say" text spoken. Keep "say" short (one or two sentences), plain spoken words, no
markdown, no lists. Reply with ONLY a JSON object:
{"say": "...", "actions": [ ... ]}
Actions, done in order:
  {"do": "open_app", "app": "<app id from the list>"}
  {"do": "switch", "window": "<part of an open window's title>"}
  {"do": "close", "window": "<part of an open window's title>"}
  {"do": "open", "target": "<file path like ~/Desktop/x.pdf, or a URL>"}
  {"do": "type", "text": "<text to type into the focused window>"}
  {"do": "keys", "keys": "<xdotool key names, e.g. ctrl+s or Return>"}
  {"do": "search", "query": "<text>"}   (opens the desk's search bar with this query)
  {"do": "look"}   when you must see what is on the screen to answer or act: reading or
                   describing anything inside a window ("what does my note say", "what's
                   this error", "what am I looking at"). The window list gives only titles,
                   never contents. Put look last, after e.g. a switch to the right window,
                   with "say" empty; you then get a screenshot and answer again. Don't look
                   for anything the window list or the question already tells you.
Use no actions when they are just talking or asking something. When you take actions,
keep "say" to a few words ("Opening Firefox.") or leave it empty.
Each message ends with the desktop as it is right now (open windows). Trust that over
anything said earlier: the user opens and closes windows themselves. When asked to open
something, use open_app even if you opened it before (it switches to it if it is open). Web searches: open a
URL such as https://duckduckgo.com/?q=... . Their files are in ~/Desktop and
~/Documents. Speech recognition makes mistakes: guess the likely meaning."""


# After a look: the same instructions without the look action, and saying the
# screenshot is here (with look still offered, it kept asking to look again).
SYSTEM_LOOKED = re.sub(r'  \{"do": "look"\}.*?screenshot and answer again\. Don\'t look\n.*?already tells you\.\n', '',
                       SYSTEM, flags=re.S) + """
This message comes with a screenshot of the user's screen as it is right now. Answer
from what you see in it; you can read text in it."""


def context():
    wins = open_windows()
    apps = ", ".join(f"{k} ({v})" for k, v in APPS.items())
    return (f"[Desktop right now: open windows {json.dumps(wins)}; "
            f"time {time.strftime('%A %Y-%m-%d %H:%M')}]\n[Installed apps, id (name): {apps}]")


def parse_reply(reply):
    m = re.search(r"\{.*\}", reply, re.S)
    if m:
        try:
            d = json.loads(m.group(0))
            if isinstance(d, dict):
                acts = d.get("actions") or []
                return str(d.get("say", "")), [x for x in acts if isinstance(x, dict)]
        except ValueError:
            pass
    return reply.strip(), []


# ---------- listening ----------

def rms(frame):
    s = array.array("h", frame)
    return math.sqrt(sum(x * x for x in s) / max(1, len(s)))


def to_wav(frames):
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(b"".join(frames))
    return buf.getvalue()


class Voice:
    def __init__(self):
        self.obj = ObjectServer()
        self.piper = None
        if TTS == "piper" and PiperVoice:
            self.piper = PiperVoice.load(PIPER_VOICE)
            list(self.piper.synthesize("Ready."))   # warm up: the first run is slow
        self.on = False
        self.once = False
        self.hearing = False
        self.speaking = threading.Event()
        self.rec = None
        self.utterances = queue.Queue()
        self.history = []
        threading.Thread(target=self.worker, daemon=True).start()

    def start(self, once=False):
        self.once = once
        if self.on:
            return
        self.on = True
        self.rec = subprocess.Popen(["ffmpeg", "-loglevel", "error", "-f", "pulse", "-i", SOURCE,
                                     "-ac", "1", "-ar", str(RATE), "-f", "s16le", "-"],
                                    stdout=subprocess.PIPE, stdin=subprocess.DEVNULL)
        threading.Thread(target=self.listen, args=(self.rec,), daemon=True).start()
        event("state", "listening")
        if once:
            rec = self.rec
            def give_up():   # nothing said: don't leave the microphone open
                time.sleep(ONCE_WAIT)
                if self.on and self.rec is rec and not self.hearing:
                    event("error", "didn't hear anything")
                    self.stop()
            threading.Thread(target=give_up, daemon=True).start()

    def stop(self, answering=False):
        if not self.on:
            return
        self.on = False
        if self.rec:
            self.rec.terminate()
        if not answering:   # else the answer is on its way; "off" follows it
            event("state", "off")

    def listen(self, rec):
        pre, cur, loud, quiet, speech = [], None, 0, 0, 0
        self.hearing = False
        floor = 300.0
        while True:
            frame = rec.stdout.read(FRAME * 2)
            if len(frame) < FRAME * 2:
                break
            if self.speaking.is_set():   # don't hear ourselves
                pre, cur, loud = [], None, 0
                continue
            level = rms(frame)
            if cur is None:
                floor = 0.98 * floor + 0.02 * min(level, 3000)
            thresh = max(600.0, floor * 3)
            is_loud = level > thresh
            if cur is None:
                pre = (pre + [frame])[-PREROLL:]
                loud = loud + 1 if is_loud else 0
                if loud >= START:
                    cur, quiet, speech = list(pre), 0, loud
                    self.hearing = True
                    event("state", "hearing")
                continue
            cur.append(frame)
            if is_loud:
                speech, quiet = speech + 1, 0
            else:
                quiet += 1
            if quiet >= END or len(cur) >= MAX_FRAMES:
                self.hearing = False
                if speech >= MIN_SPEECH:
                    chime()
                    self.utterances.put(to_wav(cur))
                    if self.once:   # one phrase per click: stop listening now
                        self.stop(answering=True)
                        return
                elif self.on:
                    event("state", "listening")
                pre, cur, loud = [], None, 0
        if cur and speech >= MIN_SPEECH:   # stopped mid-sentence: still answer it
            self.utterances.put(to_wav(cur))

    def worker(self):
        while True:
            wav = self.utterances.get()
            try:
                self.handle(wav)
            except Exception as e:  # keep listening whatever went wrong
                event("error", str(e))
            if self.utterances.empty():
                event("state", "listening" if self.on else "off")

    def handle(self, wav):
        t = [("start", time.monotonic())]
        mark = lambda name: t.append((name, time.monotonic()))
        event("state", "thinking")
        text = self.obj.stt(wav)
        mark("stt")
        if not text:
            return
        event("heard", text)
        reply = self.obj.chat(text + "\n\n" + context(), self.history[-12:], SYSTEM)
        mark("ai")
        say, actions = parse_reply(reply)
        if any(a.get("do") == "look" for a in actions):   # it needs to see: one screenshot, this turn only
            for a in actions[:next(i for i, a in enumerate(actions) if a.get("do") == "look")]:
                try:   # e.g. switch to the window first, so the screenshot shows it
                    event("did", act(a))
                except Exception as e:
                    event("error", str(e))
            time.sleep(0.4)
            event("did", "👁 looked at the screen")
            shot = screenshot()
            fid = self.obj.upload("screen.jpg", shot, "image/jpeg")
            try:
                reply = self.obj.chat("[Screenshot attached.] " + text + "\n\n" + context(),
                                      self.history[-12:], SYSTEM_LOOKED, attachments=[fid])
            finally:
                self.obj.delete_file(fid)
            mark("look")
            log("after looking: " + reply[:300].replace("\n", " "))
            say, actions = parse_reply(reply)
            actions = [a for a in actions if a.get("do") != "look"]
            if not say and not actions:
                say = "I looked, but I couldn't tell."

        def do_actions():
            for a in actions:
                try:
                    event("did", act(a))
                except Exception as e:
                    event("error", str(e))
        doer = threading.Thread(target=do_actions)
        doer.start()   # act and speak at the same time
        self.history += [{"role": "user", "content": text},
                         {"role": "assistant", "content": json.dumps({"say": say, "actions": actions})}]
        if say:   # the text appears as the voice starts, not before
            self.speak(say, mark, on_start=lambda: event("said", say))
        doer.join()
        steps = " ".join(f"{n} {b - a:.2f}" for (_, a), (n, b) in zip(t, t[1:]))
        log(f"timing: {steps} total-to-voice {dict(t).get('voice', t[-1][1]) - t[0][1]:.2f}s")

    def speak(self, text, mark=lambda name: None, on_start=lambda: None):
        self.speaking.set()
        try:
            if self.piper:   # stream: the first sentence plays while the rest is made
                rate = self.piper.config.sample_rate
                p = player(rate)
                started = None
                for chunk in self.piper.synthesize(text):
                    if started is None:
                        started = time.monotonic()
                        mark("voice")
                        on_start()
                    p.stdin.write(chunk.audio_int16_bytes)
                    p.stdin.flush()
                p.stdin.close()
                p.wait(timeout=120)   # pacat exits once it has all been played
            else:
                audio = self.obj.tts(text)
                mark("voice")
                on_start()
                pcm = subprocess.run(["ffmpeg", "-loglevel", "error", "-i", "pipe:0", "-f", "s16le", "-ac", "1",
                                      "-ar", "24000", "-"], input=audio, capture_output=True, timeout=60).stdout
                player(24000).communicate(pcm, timeout=120)
            mark("spoken")
        finally:
            time.sleep(0.3)   # let the tail of our own voice pass the mic
            self.speaking.clear()


def player(rate, name="nc-voice"):
    """Plays raw 16-bit mono on the desk's output. pacat, not ffmpeg: ffmpeg
    exits as soon as pulse has the audio and pulse drops what hasn't played
    yet (measured: 2 s of a 4 s tone), which cut the end off every reply."""
    return subprocess.Popen(["pacat", "--raw", f"--rate={rate}", "--channels=1", "--format=s16le",
                             f"--client-name={name}", f"--stream-name={name}"], stdin=subprocess.PIPE)


def chime():
    """A soft two-note blip: heard you, working on it."""
    rate, out = 22050, array.array("h")
    for freq, dur in ((880, 0.07), (1320, 0.09)):
        n = int(rate * dur)
        for i in range(n):
            env = min(1, i / 200, (n - i) / 400)
            out.append(int(5000 * env * math.sin(2 * math.pi * freq * i / rate)))
    player(rate, "nc-chime").communicate(out.tobytes())


def main():
    if not ADMIN:
        sys.exit("nc-voice: DBBASIC_ADMIN_TOKEN is not set")
    v = Voice()
    while True:   # follow nc-host's command stream; reconnect when it restarts
        try:
            c = UnixHTTP(SOCK)
            c.request("GET", "/voice/commands")
            r = c.getresponse()
            log("connected to nc-host")
            for line in r:
                if not line.strip():
                    continue
                cmd = json.loads(line).get("cmd")
                if cmd == "on":
                    v.start(once=bool(json.loads(line).get("once")))
                elif cmd == "off":
                    v.stop()
        except (OSError, ValueError, http.client.HTTPException) as e:
            log(f"nc-host: {e}")
        v.stop()
        time.sleep(2)


if __name__ == "__main__":
    main()
