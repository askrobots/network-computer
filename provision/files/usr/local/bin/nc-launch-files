#!/bin/sh
# rofi script mode for nc-launch: lists files in your home (the desk's
# Desktop and Documents included, hidden files and caches skipped); opens
# the one picked with its default app.
if [ -n "$1" ]; then
  p=$(printf '%s' "$1" | sed "s|^~|$HOME|")
  setsid -f xdg-open "$p" >/dev/null 2>&1
  exit 0
fi
cd "$HOME" || exit 0
find -L . -maxdepth 6 \( -name '.*' -o -name snap -o -name node_modules \) -prune -o -type f -print 2>/dev/null \
  | head -5000 | sed 's|^\.|~|'
