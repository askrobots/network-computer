[Unit]
Description=DBBASIC object server on this desk (voice, AI, data), local only
After=network-online.target
Wants=network-online.target
[Service]
# the user comes from a drop-in (user.conf) written by apply.sh
EnvironmentFile=/etc/nc/object-server.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/dbbasic-object-server
ExecStart=/opt/dbbasic-object-server/.venv/bin/uvicorn object_server:app --host 127.0.0.1 --port 8001 --log-level warning
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
