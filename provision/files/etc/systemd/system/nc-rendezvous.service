[Unit]
Description=network-computer rendezvous
After=network-online.target
[Service]
EnvironmentFile=/etc/nc/env
ExecStart=/usr/local/bin/nc-rendezvous -http :8765 -turn :3478 -public-ip ${NC_PUBLIC_IP} -local 127.0.0.1:8765 -state-dir /var/lib/nc-rendezvous
Restart=always
[Install]
WantedBy=multi-user.target
