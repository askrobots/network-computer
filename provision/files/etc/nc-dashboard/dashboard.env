# What the desktop dashboard shows besides the computer itself, and the Today
# page (the Today icon). on or off; change it and it follows within a minute.
WEATHER=on
NEWS=on
RADIO=on
# Where the weather is for: a town ("Columbus, Ohio"), or "latitude,longitude".
# Or say "weather for <town>". Only this name is sent, to Open-Meteo.
PLACE=
# us (°F, mph) or metric; empty: what the place uses
UNITS=
